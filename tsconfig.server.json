{
  "compilerOptions": {
    "target": "ES2017",
    "module": "commonjs",
    "lib": ["ES2017"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": ".",
    "paths": { "@/*": ["./src/*"] },
    "baseUrl": "."
  },
  "include": ["server/**/*.ts", "src/shared/**/*.ts"],
  "exclude": ["node_modules"]
}
